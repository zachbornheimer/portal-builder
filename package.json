{
    "name": "portal-builder",
    "version": "1.0.0",
    "description": "WordPress plugin for portal building",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "test:env": "node tests/config/assert-env.mjs",
        "test:unit": "node --test 'tests/unit/**/*.test.mjs'",
        "sheet": "node tests/support/read-sheet.mjs",
        "prove": "php tests/support/prove-live.php",
        "prove:google": "php tests/support/prove-live.php --google-only",
        "prove:anon": "php tests/support/prove-live.php --anon-only",
        "test:mocks": "node tests/mocks/selftest.mjs",
        "test:e2e": "playwright test --project=chromium",
        "test:e2e:smoke": "playwright test --project=chromium e2e/smoke.spec.ts",
        "test:e2e:admin": "playwright test --project=chromium e2e/admin",
        "test:e2e:public": "playwright test --project=chromium e2e/public",
        "test:e2e:pipeline": "playwright test --project=chromium e2e/pipeline",
        "test:e2e:video": "playwright test --project=filmed && node tests/support/copy-last-video.mjs",
        "test:e2e:uploads": "playwright test --project=chromium e2e/pipeline && playwright test --project=filmed && node tests/support/copy-last-video.mjs",
        "test:seed": "node tests/support/seed.mjs",
        "test:cleanup": "node tests/support/cleanup.mjs",
        "test:import": "node tests/support/run-import-tests.mjs",
        "ci:offline": "npm run test:mocks && npm run test:unit",
        "ci": "npm run test:env && npm run test:mocks && npm run test:unit && npm run test:e2e:smoke",
        "push": "bash scripts/push-plugin.sh"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "@sveltejs/vite-plugin-svelte": "^4.0.0",
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.6",
        "svelte": "^5.0.0",
        "tailwindcss": "^3.4.17",
        "vite": "^5.4.4"
    }
}
