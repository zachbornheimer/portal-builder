{
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0",
    "google/apiclient": "^2.17",
    "psr/log": "^1.1"
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "DragonGate\\Vendor\\",
      "classmap_prefix": "DragonGate_Vendor_",
      "packages": ["guzzlehttp/guzzle", "google/apiclient", "psr/log"],
      "exclude_from_prefix": {
        "packages": ["symfony/polyfill-php80"]
      }
    }
  }
}
